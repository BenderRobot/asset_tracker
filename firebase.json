{
  "hosting": [
    {
      "target": "prod",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/.*/**",
        "**/node_modules/**",
        "audit/**",
        "tests/**",
        "functions/**",
        "cloudflare-workers/**",
        "Microsoft/**",
        "**/*.md",
        "**/*.ps1",
        "**/*.log",
        "package.json",
        "package-lock.json",
        "vitest*.config.js",
        "firestore.rules"
      ],
      "rewrites": [],
      "headers": [
        {
          "source": "**/*.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    },
    {
      "target": "beta",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/.*/**",
        "**/node_modules/**",
        "audit/**",
        "tests/**",
        "functions/**",
        "cloudflare-workers/**",
        "Microsoft/**",
        "**/*.md",
        "**/*.ps1",
        "**/*.log",
        "package.json",
        "package-lock.json",
        "vitest*.config.js",
        "firestore.rules"
      ],
      "rewrites": [],
      "headers": [
        {
          "source": "**/*.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
