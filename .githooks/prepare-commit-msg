#!/bin/sh

# $1 contient le message final, donc le type de changement est connu avant
# la creation du commit. Les merges conservent la version deja portee par main.
if [ "$2" = "merge" ]; then
    exit 0
fi

if ! command -v node >/dev/null 2>&1; then
    echo "Node.js est requis pour preparer la version." >&2
    exit 1
fi

node scripts/prepare-release.mjs --message-file "$1"
if [ $? -ne 0 ]; then
    exit 1
fi

git add version.json RELEASES.md
