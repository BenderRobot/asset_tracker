#!/bin/sh

# $1 contient le message final, donc le type de changement est connu avant
# la creation du commit. Les merges conservent la version deja portee par main.
if [ "$2" = "merge" ]; then
    exit 0
fi

if command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -File scripts/bump-version-from-message.ps1 -CommitMessageFile "$1"
elif command -v powershell.exe >/dev/null 2>&1; then
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/bump-version-from-message.ps1 -CommitMessageFile "$1"
else
    echo "PowerShell est requis pour mettre a jour version.json." >&2
    exit 1
fi

if [ $? -ne 0 ]; then
    exit 1
fi

git add version.json
