rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin helper — reads isAdmin flag from the user's own Firestore document.
    // No PII in rules. Managed via the admin panel (users/{uid}.isAdmin = true).
    function isAdmin() {
      return request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ── Invitation codes ────────────────────────────────────────────────
    match /invitationCodes/{codeId} {
      // get: allow unauthenticated read of a single code (needed for pre-login validation)
      // list: admin only — prevents enumeration of all codes
      allow get: if true;
      allow list: if isAdmin();
      // Only admin can create or delete codes
      allow create, delete: if isAdmin();
      // Any authenticated user can mark an available code as "used" (registration)
      // Field restriction: only status/usedBy/usedAt may change — prevents self-granting modules
      allow update: if (isAdmin())
                    || (request.auth != null
                        && resource.data.status == 'available'
                        && request.resource.data.status == 'used'
                        && request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly(['status', 'usedBy', 'usedAt']));
    }

    // ── Per-user data ────────────────────────────────────────────────────
    match /users/{userId} {
      // Admin can read/write all user documents (for module management)
      // Users can read/write their own document (but not delete it)
      allow read:          if isAdmin() || isOwner(userId);

      // SECURITY FIX (privilege escalation, P0) : `isAdmin()` ci-dessus lit
      // `users/{uid}.isAdmin` — et `allow create, update: if isAdmin() ||
      // isOwner(userId)` sans restriction de champ permettait à N'IMPORTE
      // QUEL utilisateur authentifié d'écrire `isAdmin: true` sur SON PROPRE
      // document, puis d'être immédiatement reconnu admin par cette même
      // fonction (le document qu'elle lit est celui que l'utilisateur vient
      // de modifier). Un propriétaire non-admin ne peut désormais créer son
      // document qu'avec `isAdmin` absent ou `false`, et ne peut le mettre à
      // jour qu'en laissant `isAdmin` STRICTEMENT INCHANGÉ — dans les deux
      // cas, seul un admin déjà reconnu peut accorder (ou retirer) ce rôle à
      // quelqu'un d'autre. Toute autre modification de son propre document
      // (settings, profil...) reste autorisée normalement.
      allow create: if isAdmin()
                    || (isOwner(userId) && request.resource.data.get('isAdmin', false) == false);
      allow update: if isAdmin()
                    || (isOwner(userId)
                        && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false));
      allow delete:         if isAdmin();

      match /purchases/{purchaseId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /market_cache/{cacheId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /settings/{settingId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /marketData/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /watchlist/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /liveMetrics/{document} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /assistantConversations/{convId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /cache/{cacheId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /watchlistGroups/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // SECURITY FIX (données bancaires falsifiables par le client, P0/P1) :
      // ces 3 sous-collections sont écrites par le Worker Enable Banking via
      // l'API REST Firestore avec un jeton de compte de service (bypass total
      // des règles — voir cloudflare-workers/enable-banking-worker/worker.js)
      // — le client n'a JAMAIS besoin d'y écrire de champ financier. Audit du
      // code client (bank-connections.html, src/expensesApp.js,
      // src/expensesContext.js) confirmé : la seule opération d'écriture
      // cliente sur ces collections est `delete` (déconnexion d'une banque /
      // suppression de l'historique) — aucun `.set()`/`.update()`/`.add()`
      // n'existe nulle part côté client. `create`/`update` (solde de compte,
      // montant/date de transaction, métadonnées de connexion) sont donc
      // désormais réservés au backend (admin) : un utilisateur ne peut plus
      // se fabriquer un solde bancaire ou une transaction arbitraire.
      match /bankConnections/{connectionId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow create, update: if isAdmin();
      }

      match /bankAccounts/{accountId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow create, update: if isAdmin();
      }

      match /transactions/{transactionId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow create, update: if isAdmin();
      }
    }
  }
}
